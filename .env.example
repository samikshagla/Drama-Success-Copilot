# Drama Success Copilot - Environment Configuration Template
# Copy this template to .env to configure optional provider settings.
# Default mode is MockLLM (no network access or API key required).

# LLM Provider selection: "mock" (default) or "live"
LLM_PROVIDER=mock

# Optional live provider credentials (only evaluated if LLM_PROVIDER is configured for live)
# LLM_API_KEY=your-api-key-here
# LLM_MODEL_NAME=your-model-name-here
# LLM_BASE_URL=https://api.example.com/v1
